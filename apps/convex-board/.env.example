# Copy to `.env.local` (gitignored) and fill in all three.
#
# ⚠️ This example needs the project's **JWT issuer** switched on
#    (dashboard → Settings → JWT issuer). That is what publishes the JWKS
#    Convex verifies against.

VITE_AUTHOWL_PUBLISHABLE_KEY=
VITE_AUTHOWL_API_URL=

# Printed by `npx convex dev` when it links a deployment.
VITE_CONVEX_URL=

# ---------------------------------------------------------------------------
# Convex reads its own env from the DEPLOYMENT, not from this file. Set those
# two once, from your project's public-config `jwtIssuer` block:
#
#   npx convex env set AUTHOWL_ISSUER_URL <jwtIssuer.issuer>
#   npx convex env set AUTHOWL_PROJECT_ID <jwtIssuer.aud>
# ---------------------------------------------------------------------------
