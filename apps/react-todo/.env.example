# Copy to `.env.local` (gitignored) and fill from your AuthOwl dashboard.
#
# This app has no server process. Vite exposes the VITE_ pair to the browser
# bundle, and AuthOwl keeps the durable session in its HttpOnly cookie.

# Vite exposes only VITE_ variables to the browser. AuthOwl publishable keys are
# designed to be public; never put an sk_ secret in a SPA.
VITE_AUTHOWL_PUBLISHABLE_KEY=
VITE_AUTHOWL_API_URL=
