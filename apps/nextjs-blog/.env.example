# Copy this file to `.env.local` and fill it with values from your AuthOwl
# dashboard (https://authowl.dev → your project → API keys).
#
# Both values are safe to ship in a browser bundle: a publishable key is scoped
# to one environment and to the origins you allow-list server-side. `.env.local`
# is gitignored, so nothing project-specific gets committed.
#
# Leave them blank and the app renders a setup screen instead of crashing.

# Shape: pk_test_<uuid>_<random>   (pk_live_… in production)
AUTHOWL_PUBLISHABLE_KEY=

# The AuthOwl API origin your project lives on.
# Hosted: https://authowl.dev · Self-hosted: your own origin.
AUTHOWL_API_URL=

# The same two values again, exposed to the browser bundle. `@authowl/next`
# reads the unprefixed pair on the server; <AuthOwlProvider> runs in the
# browser, so it needs the NEXT_PUBLIC_ pair. Keep them identical.
NEXT_PUBLIC_AUTHOWL_PUBLISHABLE_KEY=
NEXT_PUBLIC_AUTHOWL_API_URL=
