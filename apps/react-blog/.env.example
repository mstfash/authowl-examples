# Copy to `.env.local` (gitignored) and fill from your AuthOwl dashboard.
#
# Both halves of this app read this one file: Vite exposes the VITE_ pair to the
# browser bundle, and the API loads the unprefixed pair with process.loadEnvFile.
#
# ⚠️ This example needs the project's **JWT issuer** switched on
#    (dashboard → Settings → JWT issuer). That is what lets the browser call
#    `getToken()` and lets the API verify the result against your JWKS.

# --- browser (Vite inlines anything prefixed VITE_) ---
VITE_AUTHOWL_PUBLISHABLE_KEY=
VITE_AUTHOWL_API_URL=

# --- API (Node) --- same values, no prefix.
AUTHOWL_PUBLISHABLE_KEY=
AUTHOWL_API_URL=

# Optional: the port the API listens on (Vite proxies /api here).
API_PORT=8787
